# ====================================================
# RENTO — Production Environment Variables
# ====================================================
# Bu faylni .env.production.example sifatida saqlang
# Haqiqiy qiymatlarni serverda alohida .env.production ga yozing
# ====================================================

# ===== DOMAIN =====
DOMAIN=api.rento.uz
APP_ENV=production

# ===== DATABASE =====
POSTGRES_DB=rento
POSTGRES_USER=rento_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_1
DB_HOST=postgres
DB_PORT=5432
DB_SSL_MODE=disable

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2

# ===== ELASTICSEARCH =====
ES_URL=http://elasticsearch:9200
ES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_3

# ===== MINIO =====
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=rento_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_4
MINIO_BUCKET=rento-uploads
MINIO_USE_SSL=false

# ===== RABBITMQ =====
RABBITMQ_USER=rento_mq
RABBITMQ_PASS=CHANGE_ME_STRONG_PASSWORD_5
RABBITMQ_URL=amqp://rento_mq:CHANGE_ME@rabbitmq:5672

# ===== JWT =====
JWT_SECRET=CHANGE_ME_SUPER_LONG_JWT_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===== SMS PROVIDER =====
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your_eskiz_password
ESKIZ_BASE_URL=https://notify.eskiz.uz

# ===== MONITORING =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ===== LOGGING =====
LOG_LEVEL=warn
LOG_FORMAT=json
