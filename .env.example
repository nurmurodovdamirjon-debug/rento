# ===== APPLICATION =====
APP_ENV=development
APP_PORT=3002
APP_NAME=rento-core-api
APP_VERSION=0.1.0
APP_SECRET=your-secret-key-here-change-in-production

# ===== DATABASE (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rento
DB_USER=rento_user
DB_PASSWORD=rento_secret_password
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE=5

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== ELASTICSEARCH =====
ES_URL=http://localhost:9200
ES_INDEX_LISTINGS=rento_listings

# ===== MINIO (S3) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_LISTINGS=rento-listings
MINIO_BUCKET_AVATARS=rento-avatars
MINIO_BUCKET_DOCUMENTS=rento-documents
MINIO_USE_SSL=false

# ===== JWT =====
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===== SMS (Eskiz.uz) =====
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# ===== FIREBASE (Push Notifications) =====
FIREBASE_PROJECT_ID=rento-app
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ===== RABBITMQ =====
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ===== YANDEX MAPS =====
YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# ===== PAYMENT SYSTEMS =====
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SERVICE_ID=your-click-service-id
CLICK_SECRET_KEY=your-click-secret

# ===== AUTH SERVICE =====
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001

# ===== CHAT SERVICE =====
CHAT_SERVICE_PORT=3003
CHAT_SERVICE_URL=http://localhost:3003

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_SMS_WINDOW=3600
RATE_LIMIT_SMS_MAX=3

# ===== LOGGING =====
LOG_LEVEL=debug
LOG_FORMAT=json

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== DOCKER COMPOSE =====
POSTGRES_DB=rento
POSTGRES_USER=rento_user
POSTGRES_PASSWORD=rento_secret_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
